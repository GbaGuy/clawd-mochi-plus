#!/usr/bin/env python3
"""Clawd Mochi controller over USB: serves the device's own web page on localhost and
relays /cmd, /state and /snap to the Mochi's serial port.
Usage: clawd-mochi-ui [port]  |  clawd-mochi-ui --snap out.png  (save the screen mirror)"""
import base64, binascii, fcntl, glob, json, os, re, select, sys, termios, threading, subprocess
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

HERE = os.path.dirname(os.path.realpath(__file__))
WEB_H = os.path.join(HERE, "..", "firmware", "web.h")
OFFLINE = {"mood": "offline", "bl": 0, "cap": "Mochi not on USB", "ip": "-", "u5": -1, "uw": -1, "uc": -1, "reset": ""}
lock = threading.Lock()   # one serial exchange at a time


def page():
    src = open(WEB_H, encoding="utf-8").read()
    return re.search(r'R"HTML\((.*)\)HTML"', src, re.S).group(1).encode()


def serial(line, want_reply=False):
    """Write one command line; optionally read one reply line. None if the device is absent."""
    devs = glob.glob("/dev/serial/by-id/usb-Espressif_USB_JTAG*")
    if not devs or os.path.exists(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "clawd-mochi-flashing")):
        return None
    # one question at a time across processes (clawd-mochi state/ip take the same lock)
    lockf = open(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "clawd-mochi-serial.lock"), "w")
    with lock, lockf:
        fcntl.flock(lockf, fcntl.LOCK_EX)
        fd = os.open(devs[0], os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
        try:
            attrs = termios.tcgetattr(fd)
            attrs[0] = attrs[1] = attrs[3] = 0                  # raw: no iflag/oflag/lflag processing
            attrs[2] = (attrs[2] & ~termios.HUPCL) | termios.CREAD | termios.CLOCAL | termios.CS8
            termios.tcsetattr(fd, termios.TCSANOW, attrs)
            termios.tcflush(fd, termios.TCIFLUSH)
            os.write(fd, (line.replace("\n", " ") + "\n").encode())
            if not want_reply:
                return ""
            buf = b""
            while b"\n" not in buf:
                if not select.select([fd], [], [], 2.0)[0]:
                    return None
                try:
                    buf += os.read(fd, 4096)
                except BlockingIOError:   # another reader got there first; keep waiting
                    continue
            return buf.split(b"\n", 1)[0].decode(errors="replace").strip()
        finally:
            os.close(fd)


def open_browser(url):
    # xdg-open uses the desktop's default browser (python's own guess picks the wrong one here).
    subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def snap(tries=3):
    """The Mochi's screen as 120x120 RGB565 little-endian bytes, or None. A damaged reply
    (short, or run into the next one) is retried after letting the line go quiet."""
    import time
    for _ in range(tries):
        reply = serial("snap", want_reply=True)
        if reply and reply.startswith("snap ") and len(reply) == 5 + 38400:
            try:
                return base64.b64decode(reply[5:])
            except binascii.Error:
                pass
        time.sleep(0.3)   # let a half-sent reply finish so the next try starts clean
    return None


def state():
    reply = serial("state", want_reply=True)
    try:
        return json.loads(reply) if reply else OFFLINE
    except ValueError:
        return OFFLINE


class Handler(BaseHTTPRequestHandler):
    def send(self, code, body, ctype):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        url = urlparse(self.path)
        if url.path == "/":
            self.send(200, page(), "text/html; charset=utf-8")
        elif url.path == "/state":
            self.send(200, json.dumps(state()).encode(), "application/json")
        elif url.path == "/snap":
            raw = snap()
            if raw:
                self.send(200, raw, "application/octet-stream")
            else:
                self.send(503, b"no device", "text/plain")
        elif url.path == "/cmd":
            ok = serial(parse_qs(url.query).get("c", [""])[0]) is not None
            self.send(200 if ok else 503, b"ok" if ok else b"no device", "text/plain")
        else:
            self.send(404, b"not found", "text/plain")

    def log_message(self, *args):
        pass


def save_snap(path):
    import struct
    from PIL import Image
    raw = snap()
    if not raw:
        sys.exit(1)
    img = Image.new("RGB", (120, 120))
    def panel(p):
        # look like the Mochi's panel, which shows reds much warmer than a monitor
        # (Clawd's 218,17,0 appears as ~217,119,87): bleed red into green and blue
        r, g, b = (p >> 11) << 3, ((p >> 5) & 63) << 2, (p & 31) << 3
        return r, int(g + 0.47 * r * (1 - g / 255)), int(b + 0.4 * r * (1 - b / 255))
    img.putdata([panel(p) for (p,) in struct.iter_unpack("<H", raw)])
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    tmp = path + ".tmp.png"
    img.save(tmp)
    os.replace(tmp, path)   # readers never see a half-written file


if __name__ == "__main__":
    if sys.argv[1:2] == ["--snap"]:
        save_snap(sys.argv[2])
        sys.exit(0)
    port = int(sys.argv[1]) if len(sys.argv) > 1 else 8484
    url = f"http://127.0.0.1:{port}/"
    try:
        srv = ThreadingHTTPServer(("127.0.0.1", port), Handler)   # localhost only
    except OSError:   # already running (e.g. launched twice from the app menu): just show it
        open_browser(url)
        sys.exit(0)
    print(f"Clawd Mochi controller: {url}  (Ctrl+C to stop)")
    threading.Timer(0.3, open_browser, [url]).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
